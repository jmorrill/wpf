<Window x:Class="WpfD2DTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WPF D2D/D3D11 Rendering Stress Test" Height="800" Width="1200"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar with title and backend toggle -->
        <Border Grid.Row="0" Background="#16213e" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Text="WPF Rendering Stress Test"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#e94560" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ShapeCountText"
                           Text="Shapes: --" FontSize="13" Foreground="#53c0b4"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Grid.Column="2" x:Name="ToggleBackendBtn"
                        Content="Switch to DX9 (restart)"
                        Click="ToggleBackend_Click"
                        FontSize="13" FontWeight="SemiBold"
                        Padding="16,6" Cursor="Hand"
                        Background="#e94560" Foreground="White"
                        BorderBrush="#c0392b" BorderThickness="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#c0392b"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main content area with tabs for different stress tests -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Margin="0" Padding="0" SelectedIndex="7">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#53c0b4"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="#0f3460"
                                        CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}"
                                        Margin="2,2,2,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#e94560"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Animated Shapes -->
            <TabItem Header="  Animated Shapes  " Foreground="White">
                <Canvas x:Name="AnimCanvas" ClipToBounds="True" Background="Transparent">
                    <!-- Gradient rectangle -->
                    <Rectangle x:Name="GradRect" Width="180" Height="120"
                               Canvas.Left="50" Canvas.Top="40" RadiusX="12" RadiusY="12">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#e94560" Offset="0"/>
                                <GradientStop Color="#0f3460" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <RotateTransform x:Name="RectRotate" CenterX="90" CenterY="60"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Spinning ellipse -->
                    <Ellipse x:Name="SpinEllipse" Width="140" Height="90"
                             Canvas.Left="350" Canvas.Top="60"
                             Fill="#533483" Stroke="#e94560" StrokeThickness="3">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="EllipseScale" CenterX="70" CenterY="45"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Bouncing circle -->
                    <Ellipse x:Name="BounceBall" Width="60" Height="60"
                             Canvas.Left="650" Canvas.Top="80">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#e94560" Offset="0.2"/>
                                <GradientStop Color="#0f3460" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Path / Bezier shape -->
                    <Path x:Name="BezierPath" Stroke="#53c0b4" StrokeThickness="3" Fill="#2a5298"
                          Canvas.Left="100" Canvas.Top="250"
                          Data="M 0,80 C 40,0 120,0 160,80 C 200,160 280,160 320,80"
                          Opacity="0.85">
                        <Path.Effect>
                            <DropShadowEffect Color="#e94560" BlurRadius="12" ShadowDepth="4"/>
                        </Path.Effect>
                    </Path>

                    <!-- TextBlock with blur -->
                    <TextBlock Text="Direct2D" FontSize="52" FontWeight="Bold"
                               Foreground="#e94560" Canvas.Left="480" Canvas.Top="270">
                        <TextBlock.Effect>
                            <BlurEffect Radius="2"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Spinning stars -->
                    <Path x:Name="Star1" Fill="#FFD700" Canvas.Left="800" Canvas.Top="60"
                          Data="M 25,0 L 31,18 50,18 35,30 40,50 25,38 10,50 15,30 0,18 19,18 Z">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="Star1Rotate" CenterX="25" CenterY="25"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Star2" Fill="#FF6347" Canvas.Left="870" Canvas.Top="120"
                          Data="M 20,0 L 25,14 40,14 28,24 32,40 20,30 8,40 12,24 0,14 15,14 Z">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="Star2Rotate" CenterX="20" CenterY="20"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Star3" Fill="#00CED1" Canvas.Left="940" Canvas.Top="40"
                          Data="M 18,0 L 22,12 36,12 25,20 29,36 18,27 7,36 11,20 0,12 14,12 Z">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="Star3Rotate" CenterX="18" CenterY="18"/>
                        </Path.RenderTransform>
                    </Path>

                    <!-- Concentric pulsing rings -->
                    <Ellipse x:Name="Ring1" Width="200" Height="200" Canvas.Left="750" Canvas.Top="300"
                             Stroke="#e94560" StrokeThickness="2" Fill="Transparent" Opacity="0.8"/>
                    <Ellipse x:Name="Ring2" Width="160" Height="160" Canvas.Left="770" Canvas.Top="320"
                             Stroke="#53c0b4" StrokeThickness="2" Fill="Transparent" Opacity="0.6"/>
                    <Ellipse x:Name="Ring3" Width="120" Height="120" Canvas.Left="790" Canvas.Top="340"
                             Stroke="#FFD700" StrokeThickness="2" Fill="Transparent" Opacity="0.4"/>
                    <Ellipse x:Name="Ring4" Width="80" Height="80" Canvas.Left="810" Canvas.Top="360"
                             Stroke="#FF6347" StrokeThickness="2" Fill="Transparent" Opacity="0.2"/>

                    <!-- Overlapping translucent rects -->
                    <Rectangle Width="120" Height="120" Fill="#5533c483" Stroke="#53c0b4"
                               StrokeThickness="2" Canvas.Left="500" Canvas.Top="160"
                               RadiusX="8" RadiusY="8"/>
                    <Rectangle Width="120" Height="120" Fill="#55e94560" Stroke="#e94560"
                               StrokeThickness="2" Canvas.Left="550" Canvas.Top="190"
                               RadiusX="8" RadiusY="8"/>
                    <Rectangle Width="120" Height="120" Fill="#550f3460" Stroke="#0f3460"
                               StrokeThickness="2" Canvas.Left="525" Canvas.Top="220"
                               RadiusX="8" RadiusY="8"/>

                    <!-- Polyline wave -->
                    <Polyline Stroke="#53c0b4" StrokeThickness="2.5"
                              Points="30,480 80,440 130,490 180,430 230,500 280,420 330,480 380,410 430,490 480,400"
                              Canvas.Left="0" Canvas.Top="0"/>

                    <!-- Dashed ellipses -->
                    <Ellipse Width="100" Height="60" Canvas.Left="300" Canvas.Top="430"
                             Stroke="#FFD700" StrokeThickness="3"
                             StrokeDashArray="4 2" Fill="Transparent"/>
                    <Ellipse Width="80" Height="80" Canvas.Left="420" Canvas.Top="420"
                             Stroke="#FF6347" StrokeThickness="2"
                             StrokeDashArray="2 2" Fill="Transparent"/>

                    <!-- Scrolling ticker -->
                    <TextBlock x:Name="TickerText"
                               Text="  WPF D2D/D3D11 Backend — Animated Shapes Stress Test  "
                               FontSize="18" FontWeight="Bold" Foreground="#53c0b4"
                               Canvas.Left="0" Canvas.Top="560"/>
                </Canvas>
            </TabItem>

            <!-- TAB 2: Particle swarm (code-generated) -->
            <TabItem Header="  Particle Swarm  " Foreground="White">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="10,6" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Particles: " Foreground="#53c0b4" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ParticleCountLabel" Text="300" Foreground="White" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center" MinWidth="40"/>
                            <Slider x:Name="ParticleSlider" Minimum="10" Maximum="4000" Value="300"
                                    Width="300" Margin="10,0,0,0" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="10"
                                    ValueChanged="ParticleSlider_Changed"/>
                        </StackPanel>
                    </Border>
                    <Canvas x:Name="ParticleCanvas" ClipToBounds="True" Background="#0d0d1a"/>
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Gradient grid -->
            <TabItem Header="  Gradient Grid  " Foreground="White">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="10,6" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tiles: " Foreground="#53c0b4" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GradientCountLabel" Text="200" Foreground="White" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center" MinWidth="40"/>
                            <Slider x:Name="GradientSlider" Minimum="10" Maximum="2000" Value="200"
                                    Width="300" Margin="10,0,0,0" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="10"
                                    ValueChanged="GradientSlider_Changed"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="GradientGrid" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 4: Shadow & blur stress -->
            <TabItem Header="  Effects Stress  " Foreground="White">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="10,6" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Effects: " Foreground="#53c0b4" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EffectsCountLabel" Text="80" Foreground="White" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center" MinWidth="40"/>
                            <Slider x:Name="EffectsSlider" Minimum="10" Maximum="1000" Value="80"
                                    Width="300" Margin="10,0,0,0" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="10"
                                    ValueChanged="EffectsSlider_Changed"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="EffectsPanel" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 5: Text rendering -->
            <TabItem Header="  Text Rendering  " Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TextPanel" Margin="16"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: Image Rendering -->
            <TabItem Header="  Images  " Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ImagePanel" Margin="16"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: Opacity & transforms -->
            <TabItem Header="  Opacity + Transforms  " Foreground="White">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="10,6" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shapes: " Foreground="#53c0b4" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TransformCountLabel" Text="120" Foreground="White" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center" MinWidth="40"/>
                            <Slider x:Name="TransformSlider" Minimum="10" Maximum="2000" Value="120"
                                    Width="300" Margin="10,0,0,0" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="10"
                                    ValueChanged="TransformSlider_Changed"/>
                        </StackPanel>
                    </Border>
                    <Canvas x:Name="TransformCanvas" ClipToBounds="True" Background="#0d0d1a"/>
                </DockPanel>
            </TabItem>

            <!-- TAB 8: D2D Built-in Effects -->
            <TabItem Header="  D2D Effects  " Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="D2DEffectsPanel" Margin="16"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#16213e" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontSize="13"
                           Foreground="#53c0b4" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="FPS: " FontSize="13" Foreground="Gray"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsText" Text="--" FontSize="13" FontWeight="Bold"
                               Foreground="#53c0b4" VerticalAlignment="Center" MinWidth="40"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
