<Window x:Class="WpfAnimatedShapes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Animated Shapes — Built from Source"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid>
        <Canvas x:Name="ShapeCanvas" ClipToBounds="True" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
            <Button x:Name="AddShapesButton" Content="Add 20 Shapes" Padding="12,6" Margin="0,0,8,0"
                    Click="AddShapesButton_Click" FontSize="14" />
            <Button x:Name="ClearButton" Content="Clear All" Padding="12,6" Margin="0,0,8,0"
                    Click="ClearButton_Click" FontSize="14" />
            <TextBlock x:Name="ShapeCountText" Text="Shapes: 0" Foreground="White"
                       VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0" />
            <TextBlock x:Name="FrameworkInfoText" Foreground="LimeGreen"
                       VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
